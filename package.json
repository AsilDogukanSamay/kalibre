{
  "name": "kalibre-landing",
  "private": true,
  "version": "2.0.0",
  "description": "Kalibre - glassmorphic landing page + PHP/MySQL iletisim modulu",
  "scripts": {
    "build": "tailwindcss -i resources/css/app.css -o public/assets/css/app.css --minify",
    "dev": "tailwindcss -i resources/css/app.css -o public/assets/css/app.css --watch",
    "serve": "php -S 127.0.0.1:5174 -t public public/index.php",
    "test": "php tests/run.php",
    "db": "\"../_db/mariadb-11.4.4-winx64/bin/mysqld.exe\" --datadir=\"../_db/data\" --port=3307 --console",
    "db:sql": "\"../_db/mariadb-11.4.4-winx64/bin/mariadb.exe\" -u root -P 3307 -h 127.0.0.1 kalibre",
    "start": "npm run build && npm run serve"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
