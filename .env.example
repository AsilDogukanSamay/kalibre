# ============================================================
# Ornek yapilandirma.  cp .env.example .env  ile kopyalayin.
# Gercek .env dosyasi versiyonlanmaz.
# ============================================================

# --- Uygulama ---
APP_NAME="Kalibre"
APP_URL=http://127.0.0.1:5174   # yayinda kendi alan adiniz (canonical, og ve sitemap buradan uretilir)
APP_ENV=local                   # yayinda: production
APP_DEBUG=true                  # yayinda MUTLAKA false: aksi halde hata detaylari ziyaretciye gorunur
APP_TIMEZONE=Europe/Istanbul

# Marka temasi: bosch | kalibre  (tasarim sistemi marka-bagimsizdir)
APP_BRAND=bosch

# --- Veritabani ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kalibre
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# --- Iletisim formu spam freni ---
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_MINUTES=10

# --- Kampanya geri sayimi (ISO 8601) ---
# Bos birakilirsa geri sayim bolumu hic render edilmez.

# --- Yonetim paneli  (/yonetim) ---
# Parolanin kendisi hicbir dosyada yazili degildir, yalnizca bcrypt ozeti durur.
# Ozet uretmek icin:
#   php -r "echo password_hash('yeni-parola', PASSWORD_BCRYPT), PHP_EOL;"
# Iki alandan biri bos birakilirsa panel girisi hicbir parolayi kabul etmez.
ADMIN_USER=atolye
ADMIN_PASSWORD_HASH=

# --- Yeni talep bildirimi ---
# Form kaydi veritabanina yazilir; bu ayar kimin haberdar edilecegini belirler.
# NOTIFY_TRANSPORT=log   -> storage/logs/bildirimler.log dosyasina yazar (SMTP gerekmez)
# NOTIFY_TRANSPORT=mail  -> PHP mail() ile gonderir
# NOTIFY_TO bos birakilirsa bildirim adimi sessizce atlanir.
NOTIFY_TRANSPORT=log
NOTIFY_TO=randevu@ornek.com
NOTIFY_FROM=no-reply@ornek.com

# Kampanya geri sayimi. Bos birakilirsa bolum hic render edilmez.
CAMPAIGN_ENDS_AT=2027-01-03T23:59:59+03:00
