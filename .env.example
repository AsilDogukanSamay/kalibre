# Uygulama
APP_NAME="Kalibre"
APP_URL=http://127.0.0.1:5174   # yayinda kendi alan adiniz
APP_ENV=local

# Marka temasi: bosch | kalibre  (tasarim sistemi marka-bagimsizdir)
APP_BRAND=bosch
APP_DEBUG=true
APP_TIMEZONE=Europe/Istanbul

# Veritabani
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kalibre
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Iletisim formu spam freni
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_MINUTES=10

# Kampanya geri sayimi (ISO 8601). Bos birakilirsa bolum gizlenir.
CAMPAIGN_ENDS_AT=2026-12-31T23:59:59+03:00
